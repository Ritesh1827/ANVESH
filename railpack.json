{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.13"
  },
  "steps": {
    "install": {
      "inputs": [
        {
          "step": "packages:mise"
        },
        {
          "local": true,
          "include": ["."]
        }
      ],
      "commands": [
        "cd backend && pip install -e ."
      ]
    }
  },
  "deploy": {
    "startCommand": "cd backend && uvicorn ecdat.api.app:app --host 0.0.0.0 --port $PORT"
  }
}