{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "python": "3.13"
  },
  "steps": {
    "install": {
      "inputs": [
        {
          "step": "packages:mise"
        },
        {
          "local": true,
          "include": ["."]
        }
      ],
      "commands": [
        "python -m venv /app/.venv",
        "/app/.venv/bin/pip install --upgrade pip setuptools",
        "/app/.venv/bin/pip install -e /app/backend"
      ],
      "deployOutputs": [
        ".venv"
      ]
    }
  },
  "deploy": {
    "paths": [
      "/app/.venv/bin"
    ],
    "startCommand": "/app/.venv/bin/python -m uvicorn ecdat.api.app:app --host 0.0.0.0 --port $PORT"
  }
}