# ── ECDAT Environment Configuration Example ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# See .gitignore — .env is excluded; .env.example is tracked.
#
# Required vs optional:
#   REQUIRED NOW    — needed to run the current stage (Days 1–6: none external)
#   REQUIRED LATER  — needed for a later day; leave blank until then
#   OPTIONAL        — improves functionality; has a local default alternative

# ── Database (Day 9) — REQUIRED LATER ────────────────────────────────────────
# Local Docker setup: docker run --name ecdat-postgres \
#   -e POSTGRES_PASSWORD=ecdat -e POSTGRES_DB=ecdat -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql+asyncpg://postgres:ecdat@localhost:5432/ecdat

# ── Redis (Day 7) — REQUIRED LATER ───────────────────────────────────────────
# Local Docker setup: docker run --name ecdat-redis -p 6379:6379 -d redis:7
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider (Day 7) — REQUIRED LATER ────────────────────────────────────
# Choose ONE provider. Leave the other blank.
# Anthropic Claude (recommended): https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI GPT (alternative): https://platform.openai.com
OPENAI_API_KEY=

# Gemini (alternative, fast/cheap classification): https://aistudio.google.com
GEMINI_API_KEY=

# Which provider to use: "anthropic", "openai", or "gemini"
LLM_PROVIDER=anthropic

# LLM model to use (temperature is always forced to 0 in code — PRD §8).
# Must name the selected provider's own model family; a stale cross-provider
# value is ignored in favour of that provider's default.
# Defaults: anthropic → claude-3-5-sonnet-20241022, openai → gpt-4o-mini,
# gemini → gemini-3.1-flash-lite
LLM_MODEL=claude-3-5-sonnet-20241022

# ── LLM prompt versioning (Day 7) — REQUIRED LATER ───────────────────────────
# Prompt version is part of the Redis cache key (PRD §6: Reproducibility).
# Increment this string when any prompt template changes.
LLM_PROMPT_VERSION=v1

# ── Application settings — NO USER INPUT REQUIRED ────────────────────────────
ECDAT_ENV=development
ECDAT_LOG_LEVEL=INFO

# FastAPI backend (Day 9)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ── Security (Day 9) — NO USER INPUT REQUIRED ────────────────────────────────
# Secret key for API session tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
